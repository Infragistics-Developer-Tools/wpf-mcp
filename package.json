{
  "name": "@infragistics/wpf-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Infragistics NetAdvantage for WPF — component registry and API reference",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wpf-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node --eval \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "docs:restore": "dotnet restore nuget/WpfDocs.csproj --packages nuget/packages",
    "generate": "npm run docs:restore && npx tsx scripts/build-api.ts",
    "build:all": "npm run generate && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
