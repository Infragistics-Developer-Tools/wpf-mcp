{
  "name": "@infragistics/wpf-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Infragistics NetAdvantage for WPF — component registry and API reference",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wpf-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node --eval \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "docs:restore": "dotnet restore nuget/WpfDocs.csproj --packages nuget/packages",
    "generate:types": "dotnet run --project scripts/type-extractor/TypeExtractor.csproj -- nuget/packages nuget/type-info.json",
    "generate": "npm run docs:restore && npm run generate:types && npx tsx scripts/build-api.ts",
    "build:docs": "npx tsx scripts/build-docs.ts",
    "build:themes": "npx tsx scripts/build-themes.ts",
    "docs:update": "git submodule update --remote docs/docs-wpf docs/docs-common docs/wpf-resources",
    "build:all": "npm run generate && npm run build:docs && npm run build:themes && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
