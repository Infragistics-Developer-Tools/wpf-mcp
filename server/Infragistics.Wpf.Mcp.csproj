<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>wpf-mcp</AssemblyName>
    <RootNamespace>Infragistics.Wpf.Mcp</RootNamespace>

    <!-- Overridden by scripts/pack-dotnet.ts (-p:Version=…) with the package.json / release version. -->
    <Version>0.0.0-dev</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wpf-mcp</ToolCommandName>
    <PackageId>Infragistics.Wpf.Mcp</PackageId>
    <PackageType>McpServer</PackageType>
    <Authors>Infragistics</Authors>
    <Company>Infragistics</Company>
    <Product>Infragistics MCP Server for WPF</Product>
    <AssemblyTitle>Infragistics MCP Server for WPF</AssemblyTitle>
    <Description>MCP server for Infragistics NetAdvantage for WPF — component registry, API reference, docs search and theming</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Infragistics-Developer-Tools/wpf-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Infragistics-Developer-Tools/wpf-mcp</RepositoryUrl>
    <PackageTags>mcp;model-context-protocol;wpf;xaml;infragistics;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same generated data set the TypeScript server reads; produced by `npm run build:data`. -->
    <Content Include="..\src\data\**" LinkBase="data" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="..\server.json" Pack="true" PackagePath=".mcp\server.json" />
  </ItemGroup>

</Project>
